# --- API Back-end (à copier dans backend/.env, ne jamais commiter .env) ---
PORT=3000
NODE_ENV=development

# Base de données (utilisateur applicatif créé par Sara)
DB_HOST=localhost        # mettre "db" si l'API tourne dans Docker
DB_PORT=5432
DB_NAME=helpdesk
APP_DB_USER=helpdesk_app
APP_DB_PASSWORD=change-me
# ou directement : DATABASE_URL=postgresql://helpdesk_app:...@localhost:5432/helpdesk

# Session (cookie signé). Générer : openssl rand -hex 32
SESSION_SECRET=change-me-with-a-long-random-string
# true si le site est servi en HTTPS (obligatoire en production)
COOKIE_SECURE=false

# Origine du Front-end autorisée (CORS, cookies)
CORS_ORIGIN=http://localhost:5173
# 1 si l'API est derrière un proxy (hébergement, Nginx) pour que le cookie "secure" fonctionne
TRUST_PROXY=0
